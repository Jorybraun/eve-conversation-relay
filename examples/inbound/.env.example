# Copy to .env.local in your independent copy of this example.
# All values below are fictional placeholders. Never commit the filled file.
PHONE_PUBLIC_ORIGIN=https://your-tunnel.example
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+12025550100
# Exact caller-ID allowlist, comma-separated E.164 numbers; no wildcard.
PHONE_ALLOWED_CALLERS=+12025550101
PHONE_DATABASE_PATH=./data/phone-calls.sqlite
PHONE_MODEL=openai/gpt-5.6-luna-fast
AI_GATEWAY_API_KEY=replace-with-your-ai-gateway-key
